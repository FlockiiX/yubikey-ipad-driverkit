// Code-signing settings for the app and its driver extension.
//
// Do not edit this file to sign with your own team. Create
// Config/Signing.local.xcconfig instead (Git ignores it):
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     APP_BUNDLE_IDENTIFIER = com.yourname.yubikey-usb-poc
//
// The driver's bundle identifier is always the app's followed by ".driver".

DEVELOPMENT_TEAM =
APP_BUNDLE_IDENTIFIER = com.example.yubikey-usb-poc

#include? "Signing.local.xcconfig"
